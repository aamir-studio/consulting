{
  "name": "aamir-consulting-contact-mailer",
  "main": "src/index.js",
  "compatibility_date": "2026-04-02",
  "send_email": [
    {
      "name": "CONTACT_SEND_EMAIL",
      // every inbox the Worker may send to; each must be a verified
      // destination address under Cloudflare Email Routing
      "allowed_destination_addresses": [
        "aamir.consulting@proton.me",
        "aamir.tutoring@proton.me"
      ]
    }
  ],
  "vars": {
    "CONTACT_FORM_SENDER": "mailer@aamir.consulting",
    "CONTACT_FORM_RECIPIENT": "aamir.consulting@proton.me",
    "TUTORING_FORM_RECIPIENT": "aamir.tutoring@proton.me"
  }
}
